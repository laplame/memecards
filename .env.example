# ============================================
# CONFIGURACIÓN DEL SERVIDOR (Backend)
# ============================================

# Puerto del servidor Express
PORT=3000

# Entorno de ejecución (development, production)
NODE_ENV=development

# Directorios para archivos
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
PAGES_DIR=./pages-data
IMAGES_DIR=./images

# URL base del servidor (usado para generar URLs de imágenes y recursos)
BASE_URL=http://localhost:3000

# Modo API-only (si está en 'true' o '1', no sirve el frontend React)
# Útil cuando el frontend se ejecuta en otro puerto (ej. Vite dev server en 5173)
API_ONLY=false

# ============================================
# BASE DE DATOS
# ============================================

# MongoDB Atlas Connection String
# Formato: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# También puedes usar MONGODB_URI (ambos funcionan)
MONGODB_ATLAS=
# MONGODB_URI=

# ============================================
# APIs EXTERNAS
# ============================================

# Google Gemini API Key (para generación de imágenes con Nano Banana)
# Obtén tu API key en: https://aistudio.google.com/app/apikey
# Puedes usar nano_banana o NANO_BANANA (ambos funcionan)
nano_banana=tu_api_key_de_gemini_aqui
# NANO_BANANA=tu_api_key_de_gemini_aqui

# Unsplash API Access Key (para búsqueda de imágenes)
# Obtén tu API key en: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=tu_unsplash_access_key_aqui

# ============================================
# CONFIGURACIÓN DEL FRONTEND (Vite)
# ============================================

# URL del backend para el frontend React
# En desarrollo, generalmente es http://localhost:3000
# En producción, debe ser la URL de tu servidor backend
VITE_BACKEND_URL=http://localhost:3000
